{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "T3 Code",
  "UUID": "com.t3code.controller",
  "Version": "0.1.0",
  "Author": "Yoshiofthewire",
  "Description": "Drive T3 Code from a Stream Deck — approve or deny tool calls, interrupt a turn, switch the permission mode, settle a thread, fire a prompt.",
  "Category": "T3 Code",
  "CategoryIcon": "imgs/plugin/category",
  "Icon": "imgs/plugin/icon",
  "URL": "https://github.com/Yoshiofthewire/t3code-streamdeck",
  "SDKVersion": 2,
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "20"
  },
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "linux",
      "MinimumVersion": "1.0"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Name": "Link",
      "UUID": "com.t3code.controller.link",
      "Icon": "imgs/actions/link/icon",
      "Tooltip": "Is T3 Code reachable, and how many approvals are waiting. Press to refresh.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/link/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Attention",
      "UUID": "com.t3code.controller.attention",
      "Icon": "imgs/actions/attention/icon",
      "Tooltip": "Shows the thread waiting on you. Press to select it, so Approve / Deny and the thread keys point at it.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/attention/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Git · Commit",
      "UUID": "com.t3code.controller.git.commit",
      "Icon": "imgs/actions/git.commit/icon",
      "Tooltip": "Commit the selected thread's working tree; T3 Code writes the message.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/git.commit/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Git · Publish",
      "UUID": "com.t3code.controller.git.push",
      "Icon": "imgs/actions/git.push/icon",
      "Tooltip": "Push the selected thread's branch, setting upstream if needed.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/git.push/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Git · Pull request",
      "UUID": "com.t3code.controller.git.pr",
      "Icon": "imgs/actions/git.pr/icon",
      "Tooltip": "Open a pull request for the selected thread's branch (or open the existing one).",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/git.pr/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Thread · Current",
      "UUID": "com.t3code.controller.thread.show",
      "Icon": "imgs/actions/thread.show/icon",
      "Tooltip": "The selected thread: title and status. Press to refresh.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/thread.show/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Thread · Previous",
      "UUID": "com.t3code.controller.thread.prev",
      "Icon": "imgs/actions/thread.prev/icon",
      "Tooltip": "Select the previous active thread.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/thread.prev/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Thread · Next",
      "UUID": "com.t3code.controller.thread.next",
      "Icon": "imgs/actions/thread.next/icon",
      "Tooltip": "Select the next active thread.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/thread.next/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Thread · Interrupt",
      "UUID": "com.t3code.controller.thread.stop",
      "Icon": "imgs/actions/thread.stop/icon",
      "Tooltip": "Interrupt the selected thread's running turn.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/thread.stop/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Thread · Settle",
      "UUID": "com.t3code.controller.thread.settle",
      "Icon": "imgs/actions/thread.settle/icon",
      "Tooltip": "Mark the selected thread done.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/thread.settle/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Thread · Prompt",
      "UUID": "com.t3code.controller.thread.say",
      "Icon": "imgs/actions/thread.say/icon",
      "Tooltip": "Send this key's text to the selected thread (set it in the inspector; default \"Continue.\").",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/thread.say/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Gate · Approve",
      "UUID": "com.t3code.controller.gate.approve",
      "Icon": "imgs/actions/gate.approve/icon",
      "Tooltip": "Approve the selected pending tool call.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/gate.approve/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Gate · Deny",
      "UUID": "com.t3code.controller.gate.deny",
      "Icon": "imgs/actions/gate.deny/icon",
      "Tooltip": "Decline the selected pending tool call.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/gate.deny/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Gate · Previous",
      "UUID": "com.t3code.controller.gate.prev",
      "Icon": "imgs/actions/gate.prev/icon",
      "Tooltip": "Select the previous pending approval.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/gate.prev/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Gate · Next",
      "UUID": "com.t3code.controller.gate.next",
      "Icon": "imgs/actions/gate.next/icon",
      "Tooltip": "Select the next pending approval.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/gate.next/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Mode · Supervised",
      "UUID": "com.t3code.controller.mode.supervised",
      "Icon": "imgs/actions/mode.supervised/icon",
      "Tooltip": "Ask before commands and file changes.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/mode.supervised/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Mode · Auto-accept edits",
      "UUID": "com.t3code.controller.mode.autoedits",
      "Icon": "imgs/actions/mode.autoedits/icon",
      "Tooltip": "Auto-approve edits, ask before other actions.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/mode.autoedits/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Mode · Auto",
      "UUID": "com.t3code.controller.mode.auto",
      "Icon": "imgs/actions/mode.auto/icon",
      "Tooltip": "Routine actions proceed; risky ones still ask.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/mode.auto/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Mode · Full access",
      "UUID": "com.t3code.controller.mode.full",
      "Icon": "imgs/actions/mode.full/icon",
      "Tooltip": "No prompts. Use in a worktree you can throw away.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/mode.full/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
    }
  ]
}
