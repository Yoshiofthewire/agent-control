{
  "name": "t3code-streamdeck",
  "version": "0.1.0",
  "description": "OpenDeck / Stream Deck plugin that drives T3 Code: approve tool calls, interrupt turns, switch permission modes, fire prompts.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "npm run manifest && npm run icons && rollup -c && chmod +x com.t3code.controller.sdPlugin/bin/plugin.js",
    "icons": "node scripts/make-icons.mjs",
    "manifest": "node scripts/make-manifest.mjs",
    "watch": "rollup -c -w",
    "test": "node --test --test-force-exit \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "install:opendeck": "ln -sfn \"$PWD/com.t3code.controller.sdPlugin\" \"${XDG_CONFIG_HOME:-$HOME/.config}/opendeck/plugins/com.t3code.controller.sdPlugin\""
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "rollup": "^4.24.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0",
    "ws": "^8.18.0"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
